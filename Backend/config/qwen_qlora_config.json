{
  "model_name": "qwen/qwen2.5-3b",
  "base_model_path": "qwen2.5-3b",
  "lora": {
    "rank": 8,
    "alpha": 16,
    "dropout": 0.1,
    "bias": "none",
    "target_modules": ["q_proj", "v_proj", "k_proj", "o_proj"],
    "modules_to_save": ["embed_tokens", "lm_head"]
  },
  "quantization": {
    "enabled": true,
    "bnb_4bit_compute_dtype": "float16",
    "bnb_4bit_quant_type": "nf4",
    "bnb_4bit_use_double_quant": true
  },
  "training": {
    "output_dir": "models/qwen_patent_qlora",
    "num_train_epochs": 3,
    "per_device_train_batch_size": 8,
    "per_device_eval_batch_size": 8,
    "gradient_accumulation_steps": 2,
    "learning_rate": 1e-4,
    "lr_scheduler_type": "cosine",
    "warmup_ratio": 0.1,
    "weight_decay": 0.01,
    "max_grad_norm": 1.0,
    "logging_steps": 100,
    "save_steps": 500,
    "eval_steps": 500,
    "save_total_limit": 2,
    "remove_unused_columns": false,
    "seed": 42,
    "optim": "paged_adamw_8bit"
  },
  "prompt_template": "You are a business innovator and patent analyst. Given the following patent information:\n\n{patents_context}\n\nGenerate a novel business idea for: {query}\n\nRespond with a concise JSON format:\n{{\n  \"concept_name\": \"[1-3 word business concept]\",\n  \"summary\": \"[2-3 sentence description of the business idea]\"\n}}",
  "domain": "patent-based business idea generation",
  "task": "domain pre-training on patent text"
}
